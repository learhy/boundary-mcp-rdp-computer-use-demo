# Boundary resources variables - copy to terraform.tfvars and fill in
# Get boundary_addr from the 01-cluster terraform output

boundary_addr          = "https://YOUR_CLUSTER.boundary.hashicorp.cloud"
boundary_admin_username = "admin"
boundary_admin_password = "AdminPass123!"

windows_host_ip   = "ec2-xx-xx-xx-xx.compute.amazonaws.com"
windows_username  = "Administrator"
windows_password  = "YOUR_WINDOWS_PASSWORD"

minio_endpoint   = "http://YOUR_MINIO_HOST:9000"
minio_access_key = "minioadmin"
minio_secret_key = "minioadmin123"